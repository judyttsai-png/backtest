# ---------------------------------------------------------------------------
# PARABOLA environment configuration
# Copy to `.env` (root) for docker-compose, or `backend/.env` for local runs.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Docker compose default (Postgres + TimescaleDB):
DATABASE_URL=postgresql+psycopg://parabola:parabola@postgres:5432/parabola
# Local run without Docker (SQLite, no Timescale features):
# DATABASE_URL=sqlite:///./parabola.sqlite3

# --- Redis / Celery ---------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Set to 1 to run tasks synchronously in-process (no worker/Redis needed).
# Useful for local demos and tests.
CELERY_TASK_ALWAYS_EAGER=0

# --- Data providers ---------------------------------------------------------
# synthetic | yfinance
DEFAULT_DATA_PROVIDER=yfinance

# --- API / CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---------------------------------------------------------------
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
