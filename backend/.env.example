# Local zero-infra run: SQLite + in-process tasks + the committed FX parquet.
# The installer (install.sh / install.ps1) generates a real .env from this,
# filling FX_PARQUET_PATH with the absolute path to data/fx_15min.parquet.
DATABASE_URL=sqlite:///./parabola.sqlite3
CELERY_TASK_ALWAYS_EAGER=1
DEFAULT_DATA_PROVIDER=parquet
FX_PARQUET_PATH=../data/fx_15min.parquet
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
