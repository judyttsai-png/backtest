{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "parabola-backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8000", "--reload"],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "parabola-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "frontend"
    }
  ]
}
